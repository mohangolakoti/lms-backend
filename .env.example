# ─────────────────────────────────────────────────────────────────────────────
# LMS Backend — Environment Variables Reference
#
# Copy this file to .env and fill in every value before starting the server.
# Values marked ★ REQUIRED will cause the server to refuse to start if absent.
# Never commit your actual .env file to source control.
# ─────────────────────────────────────────────────────────────────────────────


# ── Server ────────────────────────────────────────────────────────────────────

# Runtime environment. Set to "production" on Railway.
NODE_ENV=development

# Port the HTTP server listens on. Railway injects its own PORT automatically.
PORT=3000

# Logging verbosity: error | warn | info | http | debug
# Recommendation: "info" in production, "debug" in development
LOG_LEVEL=info


# ── Database ★ ────────────────────────────────────────────────────────────────

# ★ REQUIRED — MongoDB Atlas connection string (or local URI for development)
# Atlas format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/institutional-lms?retryWrites=true&w=majority

# MongoDB connection pool sizing. Tune for Atlas free tier (M0 = max 500 connections).
# Keep low (5-10) for Railway Hobby to avoid exhausting Atlas connection limits.
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2


# ── Authentication ★ ──────────────────────────────────────────────────────────

# ★ REQUIRED — Must be a long random secret (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ★ REQUIRED — Separate secret for refresh tokens (different from JWT_SECRET)
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Access token lifetime. Short-lived for security. Examples: 15m, 1h, 24h
JWT_EXPIRE=15m

# Refresh token lifetime. Longer-lived. Examples: 7d, 30d
JWT_REFRESH_EXPIRE=7d

# Secret used to sign HttpOnly auth cookies (falls back to JWT_SECRET if blank)
COOKIE_SECRET=


# ── CORS & Frontend ──────────────────────────────────────────────────────────

# Primary frontend URL. Used in CORS allowlist and password-reset email links.
# Example: https://your-client-lms.vercel.app
FRONTEND_URL=http://localhost:3001

# Optional: comma-separated list of additional allowed origins (staging, preview, etc.)
# Example: https://lms-staging.vercel.app,https://lms-preview.vercel.app
FRONTEND_URLS=


# ── Email (Nodemailer) ───────────────────────────────────────────────────────

# SMTP host. Gmail example: smtp.gmail.com
# For Gmail: enable 2FA, generate an App Password at myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com

# SMTP port: 587 (STARTTLS, recommended) or 465 (SSL)
EMAIL_PORT=587

# ★ REQUIRED for email features — Gmail/SMTP account
EMAIL_USER=your-email@gmail.com

# ★ REQUIRED for email features — Gmail App Password (not your account password)
EMAIL_PASS=your-16-char-app-password

# Sender display address shown in student inboxes
EMAIL_FROM=noreply@yourlms.com

# Max simultaneous SMTP connections in the connection pool
EMAIL_MAX_CONNECTIONS=5

# Max emails per SMTP connection before it is recycled
EMAIL_MAX_MESSAGES=100

# Announcement email queue: how many emails to send per processing cycle
EMAIL_QUEUE_BATCH_SIZE=10

# Delay (ms) between consecutive sends to respect SMTP rate limits
EMAIL_QUEUE_DELAY_MS=200

# Max delivery attempts before an email is marked failed
EMAIL_MAX_ATTEMPTS=3


# ── Cloud Storage (Cloudflare R2 / AWS S3) ───────────────────────────────────

# Storage backend: "r2" for production (Cloudflare R2 / AWS S3) | "local" for dev fallback
# Defaults to "r2". Set to "local" only if no R2 credentials are provided.
STORAGE_PROVIDER=r2

# ★ REQUIRED when STORAGE_PROVIDER=r2
# Cloudflare R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# R2 / S3 API credentials (generate in Cloudflare Dashboard → R2 → Manage API tokens)
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key

# R2 bucket name (create in Cloudflare Dashboard → R2)
R2_BUCKET=lms-assets

# Public CDN URL for your R2 bucket (enable "Public Access" in R2 Dashboard)
# Format: https://pub-<hash>.r2.dev  OR your custom domain: https://assets.yourlms.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev


# ── File Uploads (local fallback only) ────────────────────────────────────────

# Directory for local file uploads when STORAGE_PROVIDER=local (development only)
UPLOAD_PATH=./uploads

# Maximum upload size in bytes. Default: 10 MB = 10485760
MAX_FILE_SIZE=10485760


# ── Puppeteer / Certificate PDF Generation ───────────────────────────────────

# Path to Chromium binary used by Puppeteer for PDF certificate rendering.
# Railway (Nixpacks): set to the path printed by `which chromium` after build.
# Docker (Alpine):    /usr/bin/chromium-browser
# Local (macOS):      /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Skip Chromium download (use system Chromium instead of bundled binary)
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
