# Server Configuration
NODE_ENV=development
PORT=3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/institutional-lms

# MongoDB Connection Pool & Timeouts (Tuned for Atlas M0 / Serverless compatibility)
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cookie Configuration (For HttpOnly auth credentials)
# Defaults to JWT_SECRET if left blank
COOKIE_SECRET=

# Email SMTP Server Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@lms.com

# Email Connection Pooling Options
EMAIL_MAX_CONNECTIONS=5
EMAIL_MAX_MESSAGES=100

# Email Queue Configuration (For asynchronous rate-controlled announcement deliveries)
EMAIL_QUEUE_BATCH_SIZE=10
EMAIL_QUEUE_DELAY_MS=200
EMAIL_MAX_ATTEMPTS=3

# Storage Configuration
# Set to 'r2' for Cloudflare R2 / AWS S3 storage (production) or 'local' (development fallback)
STORAGE_PROVIDER=local

# Cloudflare R2 / AWS S3 S3-Compatible credentials (required if STORAGE_PROVIDER=r2)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key
R2_BUCKET=lms-assets
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# File Upload Configuration (Fallback for templates/local uploads)
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3001
# Optional comma-separated list for additional allowed web app origins
# Example: FRONTEND_URLS=https://yourapp.com,https://staging-yourapp.com
FRONTEND_URLS=
